{
  "name": "personal-health-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sample:generate": "node scripts/generate-sample-export.mjs",
    "sample:import": "node scripts/import-apple-health.mjs",
    "test:import": "npm run -s sample:generate && npm run -s sample:import && node scripts/verify-import.mjs && npm run -s sample:checkins && npm run -s sample:seed && node scripts/verify-seed.mjs",
    "test": "vitest run",
    "sample:checkins": "node scripts/generate-sample-checkins.mjs",
    "sample:conditions": "node scripts/fetch-sample-conditions.mjs",
    "sample:seed": "node scripts/build-demo-seed.mjs",
    "check:cities": "vite-node scripts/check-cities.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-health": "^8.11.10",
    "@supabase/supabase-js": "^2.50.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
