# Copy this file to .env.local and fill in both values from
# Supabase dashboard > project PersonalHealthManager > Project Settings > API.
# Use the publishable (or legacy anon) key only. Never the service_role / secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Phone app only. "on" shows the "Import from Health" button (Apple Health / Health Connect).
# Leave unset for the website and for any build that has not passed the health review (docs/mobile-build.md).
VITE_HEALTH_IMPORT=
